<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />

    <!-- The plugin excludes SQLite's runtime assets because Jellyfin provides them.
         Tests run without a server, so they supply the real thing themselves. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="match-table.json" Condition="Exists('match-table.json')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\next-ranking-fixture.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\discover-fixture.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Jellyfin.Plugin.AoideSidecar\Jellyfin.Plugin.AoideSidecar.csproj" />
  </ItemGroup>

</Project>
